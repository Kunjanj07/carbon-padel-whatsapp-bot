# Copy this file to .env and fill it in. Never share the .env file.

# ---- Connection ----
# Any long random string (e.g. run: openssl rand -hex 24). Also the WAHA dashboard password.
WAHA_API_KEY=
WAHA_SESSION=default
# The Carbon group's ID (ends in @g.us). Find it with: docker compose exec bot python carbon_bot.py --groups
GROUP_ID=

# ---- Tag-all on match alerts ----
# 1 = on, 0 = off (set 0 if the match bot already tags everyone in its own alert)
TAG_ENABLED=1
TAG_TEXT=*MATCHES WAITING @ CARBON* 🎾 @all
# Only tag when the alert comes from this number (digits only, country code, no +). Blank = any sender.
# If this package runs ON the match bot's own number, leave blank: its own alerts are picked up automatically.
TRIGGER_SENDER=
# 1 = also react to alerts sent from the bot's own number
ALLOW_OWN_ALERTS=1
# 1 = the @all message is a reply quoting the alert
REPLY_TO_ALERT=1
DELAY_SECONDS=2
# lid (default, matches how WhatsApp identifies members in newer groups) or phone
MENTION_IDS=lid
# 1 = print instead of sending (testing)
DRY_RUN=0

# ---- Scam moderator ----
# watch  = never deletes, only messages the owner (START HERE for the first week)
# delete = deletes clear scams for everyone (the bot's number must be a group admin)
MOD_MODE=watch
# Who receives the private alerts (digits only, country code, no +)
OWNER_NUMBER=
# Numbers whose messages are never checked (comma separated): admins, staff
ADMIN_NUMBERS=
TRUSTED_NUMBERS=
# Optional AI second opinion on suspicious messages (paid Anthropic API key). Blank = free, rules only.
ANTHROPIC_API_KEY=
